generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Species {
  CAT
  DOG
  OTHER
}

model User {
  id            String   @id @default(uuid())
  googleSubject String   @unique
  displayName   String?
  pets          Pet[]
  posts         Post[]
  comments      Comment[]
  adoptionListings AdoptionListing[] @relation("AdoptionAuthor")
  adoptionApplications AdoptionApplication[] @relation("AdoptionApplicant")
  createdAt     DateTime @default(now())
}

model Pet {
  id        String         @id @default(uuid())
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id])
  name      String
  species   Species
  birthDate DateTime?
  vaccines  Vaccine[]
  photos    Photo[]
  reminders Reminder[]
  alerts    LostPetAlert[]
  createdAt DateTime       @default(now())
  @@index([ownerId])
}

model Vaccine {
  id             String    @id @default(uuid())
  petId          String
  pet            Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  name           String
  administeredAt DateTime?
  nextDueAt      DateTime?
  @@index([petId])
}

model Photo {
  id         String   @id @default(uuid())
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  storageKey String
  createdAt  DateTime @default(now())
  @@index([petId])
}

model Reminder {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  title     String
  dueAt     DateTime
  completed Boolean  @default(false)
  @@index([petId, dueAt])
}

model LostPetAlert {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  status    String   @default("OPEN")
  visibility String  @default("PENDING")
  details   String?
  district  String?
  createdAt DateTime @default(now())
  @@index([status, district])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  comments  Comment[]
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model AdoptionListing {
  id           String                @id @default(uuid())
  authorId     String
  author       User                  @relation("AdoptionAuthor", fields: [authorId], references: [id])
  petName      String
  species      Species
  description  String
  district     String?
  status       String                @default("PENDING")
  createdAt    DateTime              @default(now())
  applications AdoptionApplication[]

  @@index([status, createdAt])
  @@index([authorId])
}

model AdoptionApplication {
  id          String          @id @default(uuid())
  listingId   String
  listing     AdoptionListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User            @relation("AdoptionApplicant", fields: [applicantId], references: [id])
  message     String
  status      String          @default("PENDING")
  createdAt   DateTime        @default(now())

  @@unique([listingId, applicantId])
  @@index([applicantId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([postId, status, createdAt])
  @@index([authorId])
}
