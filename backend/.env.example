# Do not commit secrets
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
PORT=3000
# Configure Firebase Admin via deployment secrets / Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# Comma-separated Firebase UIDs allowed to review community submissions.
# If unset, no content can be publicly approved.
MODERATOR_UIDS=
